# The Acute merchant API. The host decides sandbox vs live.
#   Sandbox: https://sandbox.api.acute.network
#   Live:    https://api.acute.network
ACUTE_API_BASE=https://sandbox.api.acute.network

# A secret key: Acute console, Developers, API keys. Server only. Chopdeck uses it
# to confirm what the browser says it paid, never to take the payment itself.
ACUTE_API_KEY=acuinf_sandbox_xxx

# Shown once when you register https://<this-app>/api/webhooks/acute in the console.
ACUTE_WEBHOOK_SECRET=whsec_xxx

# Turso (libSQL): this shop's own database. Schema and seed: packages/store.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_DATABASE_SECRET=your-turso-auth-token

# A publishable key: Acute console, Developers, Client apps. Public by design; it
# ships in the JavaScript bundle. The client app must list this site's origin
# (http://localhost:3001 in dev) and declare the `orderId` metadata key.
NEXT_PUBLIC_ACUTE_PUBLISHABLE_KEY=acuinf_sandbox_pk_xxx

# Only when running against a local Acute stack. Leave it out in production and
# the SDK works the host out from the key's own mode.
# NEXT_PUBLIC_ACUTE_API_BASE=http://localhost:9035
